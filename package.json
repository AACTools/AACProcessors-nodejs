{
  "name": "@willwade/aac-processors",
  "version": "0.0.0-development",
  "description": "A comprehensive TypeScript library for processing AAC (Augmentative and Alternative Communication) file formats with translation support",
  "main": "dist/index.js",
  "browser": "dist/browser/index.browser.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "node": "./dist/index.node.js",
      "browser": "./dist/browser/index.browser.js",
      "default": "./dist/index.node.js"
    },
    "./node": {
      "types": "./dist/index.node.d.ts",
      "default": "./dist/index.node.js"
    },
    "./browser": {
      "types": "./dist/index.browser.d.ts",
      "default": "./dist/browser/index.browser.js"
    },
    "./gridset": {
      "types": "./dist/gridset.d.ts",
      "default": "./dist/gridset.js"
    },
    "./snap": {
      "types": "./dist/snap.d.ts",
      "default": "./dist/snap.js"
    },
    "./obf": {
      "types": "./dist/obf.d.ts",
      "default": "./dist/obf.js"
    },
    "./obfset": {
      "types": "./dist/obfset.d.ts",
      "default": "./dist/obfset.js"
    },
    "./touchchat": {
      "types": "./dist/touchchat.d.ts",
      "default": "./dist/touchchat.js"
    },
    "./dot": {
      "types": "./dist/dot.d.ts",
      "default": "./dist/dot.js"
    },
    "./excel": {
      "types": "./dist/excel.d.ts",
      "default": "./dist/excel.js"
    },
    "./opml": {
      "types": "./dist/opml.d.ts",
      "default": "./dist/opml.js"
    },
    "./applePanels": {
      "types": "./dist/applePanels.d.ts",
      "default": "./dist/applePanels.js"
    },
    "./astericsGrid": {
      "types": "./dist/astericsGrid.d.ts",
      "default": "./dist/astericsGrid.js"
    },
    "./gotalkNow": {
      "types": "./dist/gotalkNow.d.ts",
      "default": "./dist/gotalkNow.js"
    },
    "./translation": {
      "types": "./dist/translation.d.ts",
      "default": "./dist/translation.js"
    },
    "./validation": {
      "types": "./dist/validation.d.ts",
      "default": "./dist/validation.js"
    },
    "./metrics": {
      "types": "./dist/metrics.d.ts",
      "default": "./dist/metrics.js"
    },
    "./analytics": {
      "types": "./dist/analytics.d.ts",
      "default": "./dist/analytics.js"
    }
  },
  "files": [
    "dist/**/*",
    "docs/**/*",
    "README.md",
    "LICENSE"
  ],
  "directories": {
    "doc": "docs",
    "test": "test"
  },
  "scripts": {
    "build": "npm run build:all",
    "build:node": "rimraf dist && mkdir dist && tsc -p tsconfig.node.json && npm run copy:assets",
    "build:browser": "tsc -p tsconfig.browser.json",
    "build:all": "npm run build:node && npm run build:browser",
    "build:watch": "tsc -p tsconfig.node.json --watch",
    "clean": "rimraf dist coverage",
    "copy:assets": "node scripts/copy-assets.js",
    "lint": "eslint \"src/**/*.{js,ts}\" \"test/**/*.{js,ts}\"",
    "lint:fix": "eslint \"src/**/*.{js,ts}\" \"test/**/*.{js,ts}\" --fix",
    "format": "prettier --write \"src/**/*.{js,ts}\" \"test/**/*.{js,ts}\" \"*.{js,ts,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{js,ts}\" \"test/**/*.{js,ts}\" \"*.{js,ts,json,md}\"",
    "smoke:browser": "node scripts/smoke-browser-bundle.js",
    "verify:browser-build": "node scripts/verify-browser-build.js",
    "verify:rn-bundle": "npm run build:browser && node scripts/verify-rn-bundle.js",
    "test": "npm run build && jest",
    "test:watch": "npm run build && jest --watch",
    "test:coverage": "npm run build && jest --coverage",
    "test:ci": "npm run build && jest --coverage --ci --watchAll=false --testTimeout=30000",
    "publish:ci": "npm run build:all && npm publish --access public",
    "docs": "typedoc",
    "coverage:report": "node scripts/coverage-analysis.js",
    "type-check": "tsc --noEmit",
    "prepublishOnly": "npm run build:all && npm run verify:browser-build",
    "prepack": "npm run build:all && npm run verify:browser-build"
  },
  "keywords": [
    "aac",
    "augmentative-communication",
    "alternative-communication",
    "assistive-technology",
    "accessibility",
    "communication-boards",
    "snap",
    "grid3",
    "touchchat",
    "obf",
    "opml",
    "dot",
    "typescript",
    "translation",
    "i18n"
  ],
  "author": {
    "name": "Will Wade",
    "email": "will@aactools.co.uk",
    "url": "https://github.com/willwade"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AACTools/AACProcessors-nodejs.git"
  },
  "bugs": {
    "url": "https://github.com/AACTools/AACProcessors-nodejs/issues"
  },
  "homepage": "https://github.com/AACTools/AACProcessors-nodejs#readme",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=9.0.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/better-sqlite3": "^7.6.13",
    "@types/exceljs": "^0.5.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.19.17",
    "@types/pako": "^2.0.4",
    "@types/plist": "^3.0.5",
    "@types/sql.js": "^1.4.9",
    "@typescript-eslint/eslint-plugin": "^8.58.2",
    "@typescript-eslint/parser": "^8.58.2",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.1.3",
    "fast-check": "^4.2.0",
    "jest": "^30.3.0",
    "prettier": "^3.5.3",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.4.9",
    "typedoc": "^0.28.14",
    "typescript": "~5.5.0"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "axios": "^1.11.0",
    "better-sqlite3": "^12.5.0",
    "commander": "^14.0.3",
    "exceljs": "^4.4.0",
    "fast-xml-parser": "^5.2.0",
    "jszip": "^3.10.1",
    "plist": "^3.1.0",
    "sql.js": "^1.14.1",
    "yauzl": "^3.2.0"
  },
  "bin": {
    "aac-processors": "./dist/cli/index.js"
  }
}
